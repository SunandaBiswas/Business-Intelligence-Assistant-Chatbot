# Google sign-in. Copy this file to secrets.toml (git-ignored) and fill it in.
#
# 1. https://console.cloud.google.com/ > APIs & Services > Credentials > Create OAuth client ID
#    (type: Web application).
# 2. Authorized redirect URI:  http://localhost:8501/oauth2callback
# 3. Paste the client ID / secret below. cookie_secret is any long random string.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
